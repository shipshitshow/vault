{
  "$schema": "https://biomejs.dev/schemas/2.4.12/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on",
        "useSortedKeys": "on"
      }
    }
  },
  "css": {
    "linter": {
      "enabled": false
    },
    "parser": {
      "tailwindDirectives": true
    }
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**/*.md",
      "**/*.ts",
      "**/*.tsx",
      "**/*.js",
      "**/*.jsx",
      "**/*.json",
      "**/*.css",
      "!**/node_modules",
      "!**/.agents",
      "!**/.git",
      "!**/.claude",
      "!**/.next",
      "!**/dist",
      "!**/build",
      "!**/.turbo",
      "!**/coverage",
      "!**/*.d.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    },
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "a11y": {
        "noLabelWithoutControl": "off",
        "noStaticElementInteractions": "off",
        "noSvgWithoutTitle": "off",
        "useButtonType": "off",
        "useHtmlLang": "off",
        "useKeyWithClickEvents": "off",
        "useMediaCaption": "off",
        "useSemanticElements": "off"
      },
      "complexity": {
        "noBannedTypes": "off",
        "noStaticOnlyClass": "off",
        "noUselessConstructor": "off",
        "noUselessSwitchCase": "off",
        "noVoid": "off",
        "useArrowFunction": {
          "level": "warn"
        },
        "useFlatMap": {
          "level": "warn"
        },
        "useLiteralKeys": "off",
        "useOptionalChain": "off"
      },
      "correctness": {
        "noChildrenProp": "off",
        "noConstantCondition": {
          "level": "warn"
        },
        "noEmptyPattern": "off",
        "noUnusedFunctionParameters": "off",
        "noUnusedImports": "error",
        "noUnusedPrivateClassMembers": "off",
        "noUnusedVariables": "off",
        "noVoidTypeReturn": "off",
        "useExhaustiveDependencies": "off"
      },
      "performance": {
        "noAccumulatingSpread": "off",
        "noImgElement": "off"
      },
      "recommended": true,
      "security": {
        "noDangerouslySetInnerHtml": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useBlockStatements": "off",
        "useConst": {
          "level": "warn"
        },
        "useExportType": {
          "level": "warn"
        },
        "useImportType": "off",
        "useNodejsImportProtocol": {
          "level": "warn"
        },
        "useTemplate": "off"
      },
      "suspicious": {
        "noArrayIndexKey": "off",
        "noAssignInExpressions": "off",
        "noDocumentCookie": "off",
        "noEmptyBlockStatements": "off",
        "noExplicitAny": "off",
        "noImplicitAnyLet": "off",
        "noShadowRestrictedNames": "off",
        "noThenProperty": "off",
        "useAdjacentOverloadSignatures": "off",
        "useAwait": "off",
        "useIterableCallbackReturn": "off"
      }
    }
  },
  "overrides": [
    {
      "assist": {
        "actions": {
          "source": {
            "organizeImports": "off"
          }
        }
      },
      "includes": ["**/app.module.ts"]
    },
    {
      "includes": [
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.stories.ts",
        "**/*.stories.tsx",
        "**/*.e2e-spec.ts",
        "**/__tests__/**",
        "**/test/**",
        "**/tests/**"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "useArrowFunction": "off"
          },
          "suspicious": {
            "noAssignInExpressions": "off",
            "noExplicitAny": "off"
          }
        }
      }
    }
  ],
  "vcs": {
    "clientKind": "git",
    "enabled": true,
    "useIgnoreFile": true
  }
}
