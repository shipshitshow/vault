{
  "name": "shipshitshow-youtube",
  "description": "Ship Sh!t Show YouTube channel - content, transcripts, and thumbnail generator",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "bun run --filter '*' build",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "prepare": "husky",
    "test": "vitest",
    "test:watch": "vitest --watch"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "typescript": "5.9.3",
    "vitest": "3.0.9"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json}": [
      "biome check --write"
    ]
  }
}
